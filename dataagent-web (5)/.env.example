# DATAAGENT_API_BASE: Python DataAgent FastAPI backend used by server.ts proxy.
# The browser calls /api/* on this web server; server.ts forwards to this URL.
DATAAGENT_API_BASE="http://127.0.0.1:8000"

# VITE_DATAAGENT_API_BASE: Optional direct browser API base.
# Leave empty when using the built-in server.ts proxy.
VITE_DATAAGENT_API_BASE=""

# GEMINI_API_KEY: legacy AI Studio prototype routes only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
