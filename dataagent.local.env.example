DATAAGENT_DATAJUICER_ENABLED=true
# Normally populated through `.dataagent/providers/registry.json` by `dataagent setup`.
# These optional values override the registry for development or recovery.
# DATAAGENT_PROVIDER_RUNTIME_ROOT=D:\DataAgentRuntimes
# DATAAGENT_DATAJUICER_PYTHON=D:\path\to\data-juicer-env\python.exe
# DATAAGENT_DATAJUICER_PROCESS_BIN=D:\path\to\data-juicer-env\Scripts\dj-process.exe
DATAAGENT_DATAJUICER_TIMEOUT_SECONDS=300
DATAAGENT_REMOTE_ASSET_TIMEOUT_SECONDS=90
DATAAGENT_ALLOW_MODEL_DOWNLOAD=false
DATAAGENT_ALLOW_DATAJUICER_CANDIDATES=true
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
